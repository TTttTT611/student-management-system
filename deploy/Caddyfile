# Caddy reverse proxy example: obtains and renews HTTPS certificates automatically
# Usage: caddy run --config deploy/Caddyfile
your.domain.com {
    reverse_proxy 127.0.0.1:8000
    request_body {
        max_size 20MB
    }
    header {
        X-Content-Type-Options nosniff
        X-Frame-Options DENY
        Strict-Transport-Security "max-age=31536000"
    }
}
