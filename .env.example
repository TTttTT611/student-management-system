# Copy to .env and adjust. Read by local runs, docker compose and the backup scripts.

# ---- Database ----
DATABASE_URL=mysql+pymysql://root:123456@localhost:3306/student_db
# Used by docker compose only (ignored for local runs)
MYSQL_ROOT_PASSWORD=root

# ---- Security (change in production) ----
# JWT signing key. Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-to-a-long-random-string
# Session lifetime in minutes; active users are renewed automatically
ACCESS_TOKEN_EXPIRE_MINUTES=120
# Must be true behind HTTPS, otherwise the session cookie is sent in clear text
COOKIE_SECURE=false
# Set to true behind nginx / Caddy so the real client IP is used for logs and rate limiting
TRUST_PROXY=false

# ---- Login rate limiting ----
LOGIN_MAX_FAILURES=5
LOGIN_LOCK_MINUTES=15

# ---- Default admin, created on first start when no users exist ----
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# ---- Only needed when the frontend is served from another origin (e.g. Live Server) ----
CORS_ORIGINS=

# ---- Backup scripts ----
BACKUP_DIR=backups
KEEP_DAYS=30
